# Local configuration. Copy this template to .env; keep actual values out of Git.
# On Netlify set the same variable names in the site's environment settings.
APP_URL=http://localhost:3000

# Existing Supabase project. The service-role key belongs only on the server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional explicit project reference for offline cross-checks.
SUPABASE_PROJECT_REF=

# Clerk: use one instance consistently across the frontend, backend and Supabase.
# pk_test_ + https://<instance>.clerk.accounts.dev for development;
# pk_live_ + the production instance's issuer for public launch.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER_URL=
# Comma-separated exact app origins, without paths or trailing slashes.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Session verification uses public JWKS; CLERK_SECRET_KEY is not required.

# Server-only football-data.org CL catalog import/sync; never use a VITE_ prefix.
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_SYNC_SECRET=
FOOTBALL_DATA_SYNC_WRITE_ENABLED=false

# Sync configuration is server-only. Enable writes after separately verifying sync.
RESULT_SYNC_SECRET=
RESULT_SYNC_WRITE_ENABLED=false
FIXTURE_SYNC_WRITE_ENABLED=false
