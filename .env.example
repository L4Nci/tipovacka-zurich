# Local configuration. Copy this template to .env; keep actual values out of Git.
# On Netlify set the same variable names in the site's environment settings.
APP_URL=http://localhost:3000

# Existing Supabase project. The service-role key belongs only on the server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional explicit project reference for offline cross-checks.
SUPABASE_PROJECT_REF=

# Clerk: use one instance consistently across the frontend, backend and Supabase.
# pk_test_ + https://<instance>.clerk.accounts.dev for development;
# pk_live_ + the production instance's issuer for public launch.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER_URL=
# Comma-separated exact app origins, without paths or trailing slashes.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Session verification uses public JWKS; CLERK_SECRET_KEY is not required.

# Server-only football-data.org CL catalog import/sync; never use a VITE_ prefix.
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_SYNC_SECRET=
FOOTBALL_DATA_SYNC_WRITE_ENABLED=false

# Server-only UFCalendar UFC pilot. Shares the protected sports cron above.
UFCAL_API_KEY=
MMA_SYNC_ENABLED=false

# Sync configuration is server-only. Enable writes after separately verifying sync.
RESULT_SYNC_SECRET=
RESULT_SYNC_WRITE_ENABLED=false
FIXTURE_SYNC_WRITE_ENABLED=false

# Stripe sandbox only. No Live branch or ordinary VIP grants. All gates default off.
# See docs/stripe-sandbox-readiness-2026-11-12.md before enabling local testing.
BILLING_TEST_ENABLED=false
BILLING_TEST_MODE=sandbox
BILLING_TEST_ACCOUNT_ID=acct_1UQsnbC66ykHzmj6
BILLING_TEST_APP_ORIGIN=http://localhost:3000
# Internal profile UUIDs, never Clerk subjects; comma-separated, server-owned.
BILLING_TEST_ALLOWED_PLAYER_IDS=
# Separate random bearer secret (at least32 characters) for protected recovery.
BILLING_TEST_RECONCILE_SECRET=
VITE_BILLING_TEST_UI_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_PRODUCT_ID=
STRIPE_TEST_PRICE_MONTHLY_ID=
STRIPE_TEST_PRICE_ANNUAL_ID=
STRIPE_TEST_PORTAL_CONFIGURATION_ID=

# Dormant Live branch: processing and NEW checkout are separate switches.
# Pausing NEW checkout later must not stop webhooks/refunds/renewals.
BILLING_LIVE_ENABLED=false
BILLING_LIVE_CHECKOUT_ENABLED=false
BILLING_LIVE_PUBLIC_CHECKOUT_ENABLED=false
VITE_BILLING_LIVE_UI_ENABLED=false
BILLING_LIVE_ACCOUNT_ID=
BILLING_LIVE_ALLOWED_PLAYER_IDS=
BILLING_LIVE_RECONCILE_SECRET=
# Explicit owner-accepted JSON contract; no default seller, quota, terms or tax assumption.
BILLING_LIVE_OFFER_CONTRACT=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_LIVE_PRODUCT_ID=
STRIPE_LIVE_PRICE_MONTHLY_ID=
STRIPE_LIVE_PRICE_ANNUAL_ID=
STRIPE_LIVE_PORTAL_CONFIGURATION_ID=
