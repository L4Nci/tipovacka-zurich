{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:netlify": "npm run clean && vite build",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "env:check": "node scripts/check-env.mjs",
    "test:env": "node --test scripts/check-env.test.mjs",
    "test:billing": "node --import tsx --test server/lib/billingPolicy.test.ts server/lib/stripeTestGateway.test.ts server/lib/billingTestStore.test.ts server/lib/billingTestService.test.ts server/lib/billingTestHttp.test.ts server/lib/billingLiveActivation.test.ts src/lib/billingTest.test.ts",
    "billing:check-generated": "node scripts/generate-billing-live-schema.mjs --check",
    "billing:sandbox-setup": "node scripts/stripe-sandbox-setup.mjs",
    "billing:preflight": "node --import tsx scripts/billing-preflight.ts",
    "test:clerk": "node --import tsx --test server/lib/clerkIdentity.test.ts server/lib/clerkAuthorization.test.ts src/lib/clerkSupabase.test.ts && node --import tsx server/lib/tournamentWinner_auth_scenarios.ts",
    "football-data:dry-run": "node --import dotenv/config scripts/football-data-dry-run.mjs",
    "test:football-data": "node --test scripts/football-data-dry-run.test.mjs && node --import tsx --test server/lib/footballDataSync.test.ts",
    "football-data:import": "node --import tsx scripts/football-data-import.ts",
    "hockey:import": "node --import tsx scripts/hockey-import.ts",
    "test:hockey": "node --import tsx --test server/lib/hockeyProvider.test.ts",
    "test:mma": "node --import tsx --test server/lib/mmaProvider.test.ts src/lib/mmaPredictions.test.ts src/lib/mmaLobbyData.test.ts server/lib/mmaPortraitSync.test.ts src/lib/mmaPortraits.test.ts src/lib/mmaSeason.test.ts src/lib/mmaMethods.test.ts",
    "mma:import": "node --import tsx scripts/mma-import.ts",
    "mma:portraits": "node --import tsx scripts/mma-portraits.ts",
    "test:match-presentation": "node --import tsx --test src/lib/matchPresentation.test.ts",
    "test:i18n": "node --import tsx --test src/i18n/index.test.ts"
  },
  "dependencies": {
    "@clerk/localizations": "4.24.6",
    "@clerk/react": "6.18.4",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "1.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "jose": "6.2.14",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "stripe": "23.1.0",
    "vite": "^6.4.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "1.5.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.4.6"
  }
}
